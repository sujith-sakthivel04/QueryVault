  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "objective": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Objective"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "objective"
        ],
        "title": "AgentRequest"
      },
      "ExecuteRequest": {
        "properties": {
          "quote_id": {
            "type": "string",
            "title": "Quote Id"
          },
          "max_price_cents": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Price Cents"
          },
          "sql_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sql Hash"
          }
        },
        "type": "object",
        "required": [
          "quote_id"
        ],
        "title": "ExecuteRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuoteRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "sql": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Sql"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "sql"
        ],
        "title": "QuoteRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
