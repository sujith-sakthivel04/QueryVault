# Non-secret Compose interpolation only. Copy to ignored .env.deploy.
# Use the exact future HTTPS origin when hosting is separately authorized.
# Loopback HTTP is permitted for isolated local verification.
QUERYVAULT_PUBLIC_ORIGIN=http://127.0.0.1:8080
QUERYVAULT_HOST_PORT=8080
# Phase B2 stays off unless enabled explicitly. A mounted Groq key is also required.
QUERYVAULT_INTERACTIVE_ENABLED=false
